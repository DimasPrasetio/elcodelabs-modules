APP_ENV=development
APP_PORT=8080
APP_NAME=Testbed App
# Where business dates and calendar schedules are counted (IANA name).
APP_TIMEZONE=Asia/Jakarta

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=testbedapp_db
# Go DSN (database/sql + MySQL driver) — no scheme prefix
DB_DSN=root:@tcp(localhost:3306)/testbedapp_db

JWT_SECRET=change-me
JWT_EXPIRES_IN=24h

# Production build directory of the frontend, served by the container.
# Left empty in dev — the frontend is served by Vite instead.
PUBLIC_DIR=

# Left empty so the frontend uses the same origin (see the Vite proxy in vite.config.ts).
# Only set this when web and api are actually deployed separately.
VITE_API_BASE_URL=
